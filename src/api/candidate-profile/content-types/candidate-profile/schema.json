{
  "kind": "collectionType",
  "collectionName": "candidate_profiles",
  "info": {
    "singularName": "candidate-profile",
    "pluralName": "candidate-profiles",
    "displayName": "Candidate Profile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "audios"
      ]
    },
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "phone": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "candidate_profile"
    },
    "skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill",
      "mappedBy": "candidate_profile"
    },
    "education": {
      "type": "component",
      "component": "shared.education",
      "repeatable": true
    },
    "experience": {
      "type": "component",
      "component": "shared.experience",
      "repeatable": true
    }
  }
}
