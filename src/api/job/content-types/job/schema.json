{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "description": {
      "type": "blocks"
    },
    "workplaceType": {
      "type": "enumeration",
      "enum": [
        "Remote",
        "On Site",
        "Hybrid"
      ]
    },
    "location": {
      "type": "string"
    },
    "jobType": {
      "type": "enumeration",
      "enum": [
        "Full Time",
        "Part Time",
        "Contract",
        "Internship"
      ]
    },
    "salary": {
      "type": "component",
      "component": "shared.salary-range",
      "repeatable": false
    },
    "experience": {
      "type": "enumeration",
      "enum": [
        "Entry",
        "Mid",
        "Senior",
        "Director"
      ]
    },
    "deadline": {
      "type": "date"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "jobs"
    },
    "approvalStatus": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Needs Modification"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "job"
    },
    "jobCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "jobs"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::application.application",
      "mappedBy": "job"
    },
    "saved_jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::saved-job.saved-job",
      "mappedBy": "job"
    }
  }
}
