{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "industry": {
      "type": "enumeration",
      "enum": [
        "Technology",
        "Healthcare",
        "Finance",
        "Education",
        "Manufacturing",
        "Retail",
        "Hospitality",
        "Construction",
        "Consulting",
        "Other"
      ]
    },
    "companySize": {
      "type": "enumeration",
      "enum": [
        "I(1-10)",
        "II(1-50)",
        "III(51-200)",
        "IV(201-500)",
        "V(500+)"
      ]
    },
    "slug": {
      "type": "uid"
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "company"
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "company"
    },
    "employers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::employer-profile.employer-profile",
      "mappedBy": "company"
    },
    "tagline": {
      "type": "string"
    },
    "socialLinks": {
      "type": "component",
      "component": "common.link-with-icon",
      "repeatable": true
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    }
  }
}
